[general]
rtpstart={{ rtp_start }}
rtpend={{ rtp_end }}
{% if webrtc_enable and ice_advertise_addr %}
; WebRTC needs ICE (an RTP-level feature — lives here, not in pjsip.conf). webrtc=yes turns on
; ice_support at the endpoint, but the ICE agent only gathers candidates when icesupport=yes.
icesupport=yes
; The line's namespace sits behind the host: the only host candidate Asterisk gathers is its
; private veth address ({{ rtp_bind_addr }}), which a LAN browser (e.g. 192.168.1.x) cannot
; reach. Rewrite it to the host LAN IP, whose RTP ports the orchestrator DNATs to this line, so
; the browser's SRTP lands on us. include_local_address ALSO keeps the veth address as a
; candidate, so ICE picks whichever the peer can actually reach.
; No stunaddr: both peers are on the LAN and the reachable address is statically known (docs
; warn against mixing stunaddr/turnaddr with an explicit [ice_host_candidates] mapping).
[ice_host_candidates]
{{ rtp_bind_addr }} => {{ ice_advertise_addr }},include_local_address
{% endif %}
