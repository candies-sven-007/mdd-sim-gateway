[directories]
; Asterisk's own logs go to the line's log directory so they outlive an engine restart. The
; control socket goes to the line's run directory, where the control plane (group mdd) reaches
; it with `asterisk -r -s` (control/app/engine.py). Everything else stays at the build-time
; default, which the engine unit gives each line privately.
astlogdir = {{ ast_logdir }}
astrundir = {{ rundir }}/asterisk
{% if ast_datadir %}
; Read-only data from the release (documentation/ must exist or Asterisk exits at startup).
astdatadir = {{ ast_datadir }}
{% endif %}

[options]
verbose = {{ 5 if debug_asterisk else 2 }}
debug = {{ 5 if debug_asterisk else 0 }}

[files]
astctlpermissions = 0660
