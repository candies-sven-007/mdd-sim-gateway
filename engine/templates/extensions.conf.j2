{% set local_eps = [] %}
{% if webrtc_enable %}{% set _ = local_eps.append('PJSIP/' ~ webrtc_user) %}{% endif %}
{% set dialstr = local_eps | join('&') %}
{% set inbound_ring_seconds = 60 %}
{# Match every non-empty printable extension without Asterisk's noisy bare `_.` wildcard.
   The leading ASCII character set preserves UUID/GRUU, SIP/TEL and short-code users; the
   trailing `!` allows the original one-character minimum and is safe in these request-driven
   SIP contexts (there is no overlap-dial digit collection here). #}
{% set any_extension = '_[!-~]!' %}

; ===== Incoming call from the IMS/VoWiFi side =====
[volte_ims]
; MUST match any non-empty printable user: the IMS routes inbound calls to our REGISTERED CONTACT, whose
; user part is a random GRUU/UUID (e.g. ef666c87-...@[v6]:port), NOT a phone number — so a
; numeric-only pattern like _[+0-9]. never matches and every incoming call is 404-rejected.
; The explicit h/i/t handlers below take precedence over the catch-all, so no phantom "call to h" is
; logged (that was the original reason _. had been narrowed).
exten => {{ any_extension }},1,NoOp(Incoming call from ${CALLERID(num)})
same => n,Set(CALLPEER=${CALLERID(num)})
same => n,Progress()
same => n,Set(FILE({{ logdir }}/calls.txt,,,a)=IN call from ${CALLERID(num)} at ${STRFTIME(${EPOCH},,%Y-%m-%d %H:%M:%S)})
same => n,TrySystem({{ python }} {{ engine_dir }}/notify.py call_in "${CALLERID(num)}" &)
same => n,WaitForPrecondition(10,2000)
same => n,Ringing()
{% if dialstr %}
; A push notification is useful only if the caller is still available after the administrator
; opens and signs in to the WebUI.  Dial(PJSIP/webrtc) returns CHANUNAVAIL immediately when no
; browser Contact exists, which used to end the call before that could happen.  Keep the inbound
; IMS dialog ringing for the same bounded answer window and poll the AOR; a browser that registers
; during the window is dialled with exactly the time remaining, so this does not leave an INVITE
; alive indefinitely.
same => n,Set(BROWSER_PICKUP_DEADLINE=$[${EPOCH}+{{ inbound_ring_seconds }}])
same => n(wait_browser),Set(BROWSER_CONTACTS=${PJSIP_DIAL_CONTACTS({{ webrtc_user }})})
same => n,GotoIf($["${BROWSER_CONTACTS}"!=""]?dial_browser)
same => n,GotoIf($[${EPOCH}>=${BROWSER_PICKUP_DEADLINE}]?unanswered)
same => n,Wait(1)
same => n,Goto(wait_browser)
same => n(dial_browser),Set(BROWSER_PICKUP_REMAINING=$[${BROWSER_PICKUP_DEADLINE}-${EPOCH}])
same => n,GotoIf($[${BROWSER_PICKUP_REMAINING}<=0]?unanswered)
same => n,Dial({{ dialstr }},${BROWSER_PICKUP_REMAINING})
; A Contact can disappear between the poll and Dial().  Resume waiting only for that transport
; race; a real decline/busy/no-answer remains the user's final decision.
same => n,GotoIf($["${DIALSTATUS}"="CHANUNAVAIL" & ${EPOCH}<${BROWSER_PICKUP_DEADLINE}]?wait_browser)
same => n(unanswered),NoOp(Browser pickup window expired)
{% else %}
same => n,Answer()
same => n,Wait(30)
{% endif %}
same => n(bye),Hangup()
; i (invalid) / t (response timeout) are explicit no-ops so the catch-all never mislogs them.
exten => i,1,Hangup()
exten => t,1,Hangup()
; The hangup handler ALWAYS runs (whether the caller hangs up unanswered, we decline, or the
; call completes), so the "ringing" record is finalized to a real disposition here instead of
; only after Dial() (which is skipped when the inbound leg is torn down first).
; CRITICAL: after its last priority Asterisk auto-increments to one 'h' does NOT define, so it
; would FALL THROUGH to the broad catch-all (priorities 2-9: Set/Progress/call_in/Dial…) and fire
; a phantom SECOND `call_in` (+ a stray Dial) for every call — leaving a ghost 'ringing' row in
; the call log. Hangup() terminates the ordinary 'h' routine so no fall-through happens; Return()
; is invalid here because this special extension was not entered through Gosub().
exten => h,1,Gosub(hangup-by,s,1)
same => n,TrySystem({{ python }} {{ engine_dir }}/notify.py call_result in "${CALLPEER}" "${DIALSTATUS}" "${HANGUPCAUSE}" "${GOSUB_RETVAL}" &)
same => n,Hangup()

; ===== Incoming SMS from the IMS/VoWiFi side (receive only) =====
; res_pjsip_messaging answers 200 and sends the RP-ACK the SMSC waits for only when the message
; has a destination in the dialplan, so every MT message is routed here. The text goes to the
; control plane through notify.py and nowhere else: no file is written here and notify.py keeps
; sms_in out of its local event log, because a message body (a verification code, say) must not
; sit in a plain log. Arguments 3-5 are the concatenated-SMS segment triplet (ref/total/seq)
; and 6-9 the PDU header (TP-PID, TP-DCS, UDH, raw PDU) from patches/asterisk/mt_concat_udh.py;
; all are plain integers or lowercase hex, empty when absent, so nothing here can be
; shell-injected from the network. The parts of a long text are joined by the control plane.
[volte_ims_msg]
exten => {{ any_extension }},1,NoOp(Incoming SMS)
same => n,TrySystem({{ python }} {{ engine_dir }}/notify.py sms_in "${MESSAGE(from)}" "${BASE64_ENCODE(${MESSAGE(body)})}" "${MESSAGE_DATA(SMS_CONCAT_REF)}" "${MESSAGE_DATA(SMS_CONCAT_TOTAL)}" "${MESSAGE_DATA(SMS_CONCAT_SEQ)}" "${MESSAGE_DATA(SMS_TP_PID)}" "${MESSAGE_DATA(SMS_TP_DCS)}" "${MESSAGE_DATA(SMS_UDH_HEX)}" "${MESSAGE_DATA(SMS_TPDU_HEX)}" &)
same => n,Hangup()

; ===== Outgoing call from the authenticated browser softphone =====
; Single dial attempt (no auto-redial). The dial result (incl. far-end reject) is
; reported to the manager for the call log.
[from-local]
; _[+0-9*#]. (not _.) so the special h/i/t extensions never match here and log phantom calls.
; '*' and '#' are in the class so supplementary-service and USSD codes (*21*<number>#, *#21#,
; #225#) reach the carrier's IMS, which is what decides their meaning. h/i/t are pure letters
; and still cannot match.
exten => _[+0-9*#].,1,NoOp(Outgoing call to ${EXTEN} from ${CALLERID(num)})
same => n,Set(CALLPEER=${EXTEN})
same => n,Set(FILE({{ logdir }}/calls.txt,,,a)=OUT call to ${EXTEN} at ${STRFTIME(${EPOCH},,%Y-%m-%d %H:%M:%S)})
; Quote ${EXTEN}: TrySystem runs this through a shell, where '#' starting a word begins a
; comment. An unquoted #225# swallowed the argument and every following one, so the call
; record was never created — while *#21# survived only because its '#' is mid-word.
same => n,TrySystem({{ python }} {{ engine_dir }}/notify.py call_out "${EXTEN}" &)
; Ring timeout {{ ring_timeout }}s (configurable): if the callee never answers, Asterisk
; CANCELs the outbound INVITE at this deadline instead of leaving it open. The carrier keeps
; the early dialog alive and RE-ALERTS the callee (repeated 180 Ringing) for as long as our
; INVITE is pending, so a shorter timeout bounds how many ring cycles the callee gets before
; we give up. Most carriers roll to voicemail by ~30s; 35 is the default. (The repeated
; ringing itself is carrier-side MMTel behaviour and can't be removed here.) A caller who
; hangs up earlier still CANCELs immediately.
; A 3GPP UE must select one of its registered public identities when originating
; a session. O2 UK otherwise accepts the INVITE at the P-CSCF (100 Trying) but
; has the TAS terminate it immediately with 487 Request Terminated.
; '#' must be percent-escaped again on the way out: PJSIP decoded it out of the inbound
; request URI, and an unescaped '#' would truncate the outbound URI's user part. A plain
; number contains no '#', so this is a no-op for ordinary calls. Log/notify keep raw ${EXTEN}.


same => n,Set(DIALTARGET=${STRREPLACE(EXTEN,#,%23)})
{% if invite_uri_params %}
; This line's carrier routes a call only with these request-URI parameters (T-Mobile US: 500
; "CC_IMS_TRY_NEXT_MGCF_FAIL" without user=phone), so the URI is spelled out here rather than
; letting the endpoint build it. ';' starts a comment in Asterisk configuration, hence the
; escaping.
same => n,Dial(PJSIP/volte_ims/sip:${DIALTARGET}@{{ realm }}\;{{ invite_uri_params | replace(";", "\\;") }},{{ ring_timeout }},b(ims-outbound-headers^s^1))
{% else %}
same => n,Dial(PJSIP/${DIALTARGET}@volte_ims,{{ ring_timeout }},b(ims-outbound-headers^s^1))
{% endif %}
; Dial only returns here when the call was NEVER answered (reject/busy/no-answer/congestion);
; answered calls are bridged and tear down via BYE, never reaching this line.
; Save the REAL disposition for the call log BEFORE overriding the response (PJSIPHangup does
; not clobber HANGUPCAUSE, but Set them first so the 'h' handler is order-independent).
same => n,Set(REALSTATUS=${DIALSTATUS})
same => n,Set(REALCAUSE=${HANGUPCAUSE})
; CRITICAL: on a rejected/unavailable call the carrier (Telus IMS) returns "480 Temporarily
; Unavailable", which Asterisk forwards to the local caller. 480 is a RETRYABLE response
; (RFC 3261 §21.4.11), so MicroSIP auto-redials forever and JsSIP hangs. Force a clean,
; non-retryable "603 Decline" to the caller instead so the client stops and shows the call as
; ended/declined. (ANSWER never reaches here; the guard is belt-and-suspenders.)
same => n,ExecIf($["${DIALSTATUS}" != "ANSWER"]?PJSIPHangup(Decline))
same => n,Hangup()
; Report the outcome from the hangup handler, NOT inline after Dial(): when the caller
; (softphone) hangs up mid-ring, the caller channel is destroyed and jumps straight to 'h',
; so an inline call_result would never run and the record would stay stuck on "dialing".
; Use REALSTATUS/REALCAUSE (captured right after Dial) so the log keeps the TRUE far-end
; disposition (e.g. CHANUNAVAIL/31) rather than the overridden Decline; fall back to the live
; vars when REAL* are unset (caller hung up mid-ring → jumped straight to 'h' before Set).
exten => h,1,Set(ST=${IF($["${REALSTATUS}" != ""]?${REALSTATUS}:${DIALSTATUS})})
same => n,Set(CS=${IF($["${REALCAUSE}" != ""]?${REALCAUSE}:${HANGUPCAUSE})})
same => n,Gosub(hangup-by,s,1)
same => n,TrySystem({{ python }} {{ engine_dir }}/notify.py call_result out "${CALLPEER}" "${ST}" "${CS}" "${GOSUB_RETVAL}" &)
same => n,Hangup()

[hangup-by]
; Which side ended the call, as a closed token for the call log and the support bundle: an
; answered call that drops within a second reads identically as ANSWER/16 whether the carrier,
; the browser or this gateway tore it down, and a report cannot be diagnosed without knowing.
; chan_pjsip stamps CHANNEL(hangupsource) with the name of the FIRST SIP session to end — a
; BYE or final failure received on it, or a session-layer teardown such as a rejected SDP
; answer — and copies it onto the bridged peer. It stays empty when the channel core hung up
; first (the dialplan's own Hangup(), a Dial timeout). So "carrier" means the carrier's dialog
; ended first, not strictly that the carrier sent the BYE; Asterisk's WARNING lines in the
; support bundle tell those apart.
exten => s,1,Set(HS=${CHANNEL(hangupsource)})
same => n,Set(BY=${IF($["${HS}" = ""]?gateway:local)})
same => n,ExecIf($["${HS:0:16}" = "PJSIP/volte_ims-"]?Set(BY=carrier))
same => n,Return(${BY})

[ims-outbound-headers]
exten => s,1,Set(PJSIP_HEADER(add,P-Preferred-Identity)=<tel:{{ msisdn }}>)
same => n,Return()

; ===== SIP MESSAGE from the browser softphone =====
; Deliberately empty: this build sends no SMS. A MESSAGE from a local client finds no extension
; here and is answered 404, instead of falling through to [from-local] and its Dial() logic.
[msg-from-local]
