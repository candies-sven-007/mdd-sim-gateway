#!/opt/mdd/current/venv/bin/python3 -I
"""Bluetooth speaker control for the web UI: the only Bluetooth command the control plane may
run as root (see /etc/sudoers.d/mdd).

    mdd-btctl status
    mdd-btctl scan
    mdd-btctl {pair|connect|disconnect|remove} AA:BB:CC:DD:EE:FF
    mdd-btctl volume 0-100
    mdd-btctl mute {0|1}
    mdd-btctl autoconnect {AA:BB:CC:DD:EE:FF|none}

Every argument is checked here, whatever the caller already checked; sudo 1.9.5 (Debian 11)
cannot restrict arguments itself. Commands run from an argument list with a pinned PATH and
environment, never through a shell. Output is one JSON object on stdout: the full state for
`status`, {"ok": bool, "message": str} for everything else. Exit status 64 is a refused
request; 0 otherwise, so the caller reads the outcome from the JSON.

Actions that change something are serialised with flock on LOCK_PATH. `status` only reads and
does not wait for that lock: a pairing holds it for up to ~40 s, and the page polls status
every second while it lasts.
"""
import fcntl
import json
import os
import queue
import re
import shutil
import signal
import subprocess
import sys
import threading
import time

PATH = "/usr/sbin:/usr/bin:/sbin:/bin"
ENV = {"PATH": PATH, "LC_ALL": "C", "LANG": "C", "HOME": "/root",
       "PULSE_SERVER": "unix:/run/pulse/native"}
LOCK_PATH = "/run/mdd-btctl.lock"
SCAN_STATE = "/run/mdd-btctl.scan"
AUTOCONNECT_FILE = "/var/lib/bt-speaker/autoconnect"
SCAN_SECONDS = 30
LOCK_WAIT_SECONDS = 45

MAC_RE = re.compile(r"[0-9A-F]{2}(:[0-9A-F]{2}){5}")
DEVICE_LINE_RE = re.compile(r"^Device ((?:[0-9A-F]{2}:){5}[0-9A-F]{2}) (.*)$")
ANSI_RE = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]|\x01|\x02|\r")
AUDIO_SINK_UUID = "0000110b"            # A2DP Audio Sink
ACTIONS = ("status", "scan", "pair", "connect", "disconnect", "remove", "volume", "mute",
           "autoconnect")


class Refused(Exception):
    """The request itself is not acceptable (exit 64)."""


# ------------------------------------------------------------------------------ validation
def check_mac(value: str) -> str:
    if not isinstance(value, str) or not MAC_RE.fullmatch(value):
        raise Refused("invalid MAC address")
    return value


def check_volume(value: str) -> int:
    if not isinstance(value, str) or not re.fullmatch(r"[0-9]{1,3}", value) \
            or not 0 <= int(value) <= 100:
        raise Refused("volume must be an integer 0-100")
    return int(value)


def check_mute(value: str) -> bool:
    if value not in ("0", "1"):
        raise Refused("mute must be 0 or 1")
    return value == "1"


def check_autoconnect(value: str) -> str | None:
    return None if value == "none" else check_mac(value)


def parse_args(argv: list[str]) -> tuple[str, object]:
    if not argv or argv[0] not in ACTIONS:
        raise Refused("unknown action")
    action, args = argv[0], argv[1:]
    expected = 0 if action in ("status", "scan") else 1
    if len(args) != expected:
        raise Refused(f"{action} takes {expected} argument(s)")
    if action in ("pair", "connect", "disconnect", "remove"):
        return action, check_mac(args[0])
    if action == "volume":
        return action, check_volume(args[0])
    if action == "mute":
        return action, check_mute(args[0])
    if action == "autoconnect":
        return action, check_autoconnect(args[0])
    return action, None


# --------------------------------------------------------------------------------- parsing
def clean_text(text: str) -> str:
    return ANSI_RE.sub("", text)


def clean_name(name: str) -> str:
    """Speakers pad names with zero-width spaces (seen: "MI Portable Speaker\\u200b")."""
    for invisible in ("​", "‌", "‍", "﻿"):
        name = name.replace(invisible, "")
    return name.strip()


def parse_kv(text: str) -> tuple[dict, list]:
    """`bluetoothctl show`/`info` "Key: value" lines; UUID lines collected separately."""
    info, uuids = {}, []
    for line in clean_text(text).splitlines():
        key, sep, value = line.strip().partition(": ")
        if not sep:
            continue
        if key == "UUID":
            uuids.append(value)
        else:
            info.setdefault(key, value)
    return info, uuids


def parse_devices(text: str) -> list[tuple[str, str]]:
    found = []
    for line in clean_text(text).splitlines():
        match = DEVICE_LINE_RE.match(line.strip())
        if match:
            found.append((match.group(1), clean_name(match.group(2))))
    return found


def device_entry(mac: str, name: str, info_text: str) -> dict:
    info, uuids = parse_kv(info_text)
    name = clean_name(info.get("Alias") or info.get("Name") or name)
    return {
        "mac": mac,
        "name": name,
        # bluez names an unnamed (usually BLE) device after its address: 98-FC-84-01-5C-1B.
        "named": bool(name) and name.replace("-", ":").upper() != mac,
        "paired": info.get("Paired") == "yes",
        "trusted": info.get("Trusted") == "yes",
        "connected": info.get("Connected") == "yes",
        "audio": info.get("Icon", "").startswith("audio")
                 or any(AUDIO_SINK_UUID in uuid.lower() for uuid in uuids),
    }


def parse_sinks(text: str) -> list[dict]:
    """`pactl list sinks` (PulseAudio 14 has no get-sink-volume). The first "Volume:" line of
    a sink is its volume; "Base Volume:" is a different line and must not be taken for it."""
    sinks, current = [], None
    for line in clean_text(text).splitlines():
        stripped = line.strip()
        if stripped.startswith("Name: "):
            current = {"name": stripped[6:], "description": "", "volume": None,
                       "muted": False}
            sinks.append(current)
        elif current is None:
            continue
        elif stripped.startswith("Description: "):
            current["description"] = stripped[13:]
        elif stripped.startswith("Volume: ") and current["volume"] is None:
            percents = [int(p) for p in re.findall(r"(\d+)%", stripped)]
            current["volume"] = round(sum(percents) / len(percents)) if percents else None
        elif stripped.startswith("Mute: "):
            current["muted"] = stripped.endswith("yes")
    return sinks


def bluetooth_sink(sinks: list[dict]) -> dict | None:
    return next((sink for sink in sinks if sink["name"].startswith("bluez_sink.")), None)


# -------------------------------------------------------------------------------- commands
def tool(name: str) -> str | None:
    return shutil.which(name, path=PATH)


def run(*args: str, timeout: float = 15) -> str:
    try:
        done = subprocess.run(list(args), env=ENV, stdin=subprocess.DEVNULL,
                              stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
                              errors="replace", timeout=timeout)
    except subprocess.TimeoutExpired as exc:
        out = exc.stdout if isinstance(exc.stdout, str) else ""
        return clean_text(out) + f"\n{args[0]} timed out"
    return clean_text(done.stdout)


def btctl(*args: str, timeout: float = 15) -> str:
    return run(tool("bluetoothctl") or "bluetoothctl", *args, timeout=timeout)


def scanning() -> bool:
    try:
        with open(SCAN_STATE) as handle:
            pid, until = handle.read().split()
        os.kill(int(pid), 0)
        return time.time() < float(until)
    except (OSError, ValueError):
        return False


def read_autoconnect() -> str | None:
    try:
        with open(AUTOCONNECT_FILE) as handle:
            value = handle.read().strip().upper()
    except OSError:
        return None
    return value if MAC_RE.fullmatch(value) else None


def status() -> dict:
    if not tool("bluetoothctl"):
        return {"available": False, "reason": "bluetoothctl is not installed"}
    show = btctl("show")
    if not show.lstrip().startswith("Controller"):
        return {"available": False, "reason": "no Bluetooth controller"}
    controller, _ = parse_kv(show)
    devices = [device_entry(mac, name, btctl("info", mac))
               for mac, name in parse_devices(btctl("devices"))]
    sink, audio_reason = None, ""
    if tool("pactl"):
        sink = bluetooth_sink(parse_sinks(run(tool("pactl"), "list", "sinks")))
    else:
        audio_reason = "pactl is not installed"
    return {"available": True, "powered": controller.get("Powered") == "yes",
            "scanning": scanning(), "autoconnect": read_autoconnect(),
            "devices": devices, "sink": sink, "audio_reason": audio_reason}


def start_scan() -> dict:
    if scanning():
        return {"ok": True, "message": "already scanning"}
    btctl("power", "on")
    process = subprocess.Popen([tool("bluetoothctl") or "bluetoothctl", "--timeout",
                                str(SCAN_SECONDS), "scan", "on"], env=ENV,
                               stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                               stderr=subprocess.DEVNULL, start_new_session=True)
    write_atomic(SCAN_STATE, f"{process.pid} {time.time() + SCAN_SECONDS}\n")
    return {"ok": True, "message": f"scanning for {SCAN_SECONDS} s"}


class Session:
    """One interactive bluetoothctl, fed through stdin.

    Pairing has to happen while discovery is running: once a scan ends, bluez soon forgets an
    unpaired device and `pair` answers "not available". Scan, pair, trust and connect in one
    session is the sequence measured to work on the device.
    """

    def __init__(self):
        self.process = subprocess.Popen([tool("bluetoothctl") or "bluetoothctl"], env=ENV,
                                        stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                        stderr=subprocess.STDOUT, text=True, errors="replace",
                                        bufsize=1, start_new_session=True)
        self.lines: queue.Queue = queue.Queue()
        self.transcript: list[str] = []
        threading.Thread(target=self._read, daemon=True).start()

    def _read(self):
        for line in self.process.stdout:
            self.lines.put(clean_text(line).strip())

    def send(self, command: str):
        self.process.stdin.write(command + "\n")
        self.process.stdin.flush()

    def wait_for(self, patterns: dict[str, str], timeout: float) -> str | None:
        """The key of the first pattern seen in the output within timeout, else None."""
        deadline = time.monotonic() + timeout
        while (left := deadline - time.monotonic()) > 0:
            try:
                line = self.lines.get(timeout=left)
            except queue.Empty:
                break
            self.transcript.append(line)
            for key, pattern in patterns.items():
                if re.search(pattern, line):
                    return key
        return None

    def close(self):
        try:
            self.send("scan off")
            self.send("quit")
            self.process.wait(timeout=3)
        except Exception:  # noqa: BLE001 - leaving is best effort; kill below
            pass
        if self.process.poll() is None:
            os.killpg(self.process.pid, signal.SIGKILL)

    def tail(self) -> str:
        return "\n".join(line for line in self.transcript if line)[-800:]


def pair(mac: str) -> dict:
    session = Session()
    try:
        session.send("agent NoInputNoOutput")
        session.send("default-agent")
        session.send("power on")
        known = "not available" not in btctl("info", mac, timeout=5)
        session.send("scan on")
        if not known and not session.wait_for({"seen": re.escape(mac)}, 18):
            return {"ok": False, "message": "device not found: put the speaker in pairing mode, "
                    "disconnect it from your phone, and try again"}
        session.send(f"pair {mac}")
        outcome = session.wait_for({"ok": r"Pairing successful|AlreadyExists",
                                    "fail": r"Failed to pair|not available|org\.bluez\.Error"},
                                   15)
        if outcome != "ok":
            return {"ok": False, "message": "pairing failed: " + (session.tail() or "no answer")}
        session.send(f"trust {mac}")
        session.wait_for({"ok": r"trust succeeded|Trusted: yes"}, 4)
        session.send(f"connect {mac}")
        outcome = session.wait_for({"ok": r"Connection successful",
                                    "fail": r"Failed to connect|org\.bluez\.Error"}, 12)
        if outcome != "ok":
            return {"ok": False, "message": "paired, but the connection failed: "
                    + (session.tail() or "no answer")}
        return {"ok": True, "message": "paired and connected"}
    finally:
        session.close()


def simple(action: str, mac: str) -> dict:
    out = btctl(action, mac, timeout=20)
    ok = {"connect": "Connection successful" in out,
          "disconnect": "Successful disconnected" in out or "not connected" in out.lower(),
          "remove": "Device has been removed" in out}[action]
    if ok and action == "remove" and read_autoconnect() == mac:
        write_atomic(AUTOCONNECT_FILE, "\n")
    return {"ok": ok, "message": "done" if ok else out.strip()[-800:]}


def sink_action(action: str, value) -> dict:
    pactl = tool("pactl")
    if not pactl:
        return {"ok": False, "message": "pactl is not installed"}
    sink = bluetooth_sink(parse_sinks(run(pactl, "list", "sinks")))
    if not sink:
        return {"ok": False, "message": "no Bluetooth speaker is connected"}
    if action == "volume":
        out = run(pactl, "set-sink-volume", sink["name"], f"{value}%")
    else:
        out = run(pactl, "set-sink-mute", sink["name"], "1" if value else "0")
    return {"ok": not out.strip(), "message": out.strip()[-800:] or "done"}


def write_atomic(path: str, text: str) -> None:
    directory = os.path.dirname(path)
    os.makedirs(directory, mode=0o755, exist_ok=True)
    temporary = f"{path}.tmp.{os.getpid()}"
    with open(temporary, "w") as handle:
        handle.write(text)
        handle.flush()
        os.fsync(handle.fileno())
    os.chmod(temporary, 0o644)
    os.replace(temporary, path)


def locked(function, *args):
    with open(LOCK_PATH, "a") as handle:
        deadline = time.monotonic() + LOCK_WAIT_SECONDS
        while True:
            try:
                fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() > deadline:
                    return {"ok": False, "message": "another Bluetooth action is still running"}
                time.sleep(0.2)
        return function(*args)


def perform(action: str, value) -> dict:
    if action == "status":
        return status()
    if not tool("bluetoothctl") and action not in ("volume", "mute", "autoconnect"):
        return {"ok": False, "message": "bluetoothctl is not installed"}
    if action == "scan":
        return locked(start_scan)
    if action == "pair":
        return locked(pair, value)
    if action in ("connect", "disconnect", "remove"):
        return locked(simple, action, value)
    if action in ("volume", "mute"):
        return locked(sink_action, action, value)
    return locked(lambda: (write_atomic(AUTOCONNECT_FILE, (value or "") + "\n"),
                           {"ok": True, "message": "saved"})[1])


def main(argv: list[str]) -> int:
    try:
        action, value = parse_args(argv)
    except Refused as exc:
        print(json.dumps({"ok": False, "message": str(exc)}))
        return 64
    print(json.dumps(perform(action, value), ensure_ascii=False))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
